<?xml version="1.0" encoding="utf-8"?>
<robot name="total_lift_openarm">
  <!--
  robot: total_lift_openarm | consumers: ROS 2 robot_state_publisher, joint_state_publisher_gui, RViz
  units: meters, kilograms, radians | frames: +X forward, +Y left, +Z up; world is bottom-center floor frame
  source: STEP assembly; OpenArm v1.1 joint origins/limits/axes from the expanded reference model.
  meshes: meshes/*.stl, exported from STEP in millimeters, scale 0.001; lift meshes use world/base frame at STEP pose
  link mapping: OpenArm STEP L1-L4 -> links0-link3; links4-link6 use official OpenArm v1.0 wrist meshes and frames; STEP J7_D is restored on link7; the STEP EE gripper remains mounted after link7
  visual origins: STEP body and proximal arm use measured assembly transforms; official wrist link4-link6 use upstream URDF frames; STEP J4-J5 covers are on link4 and J7_D is in the link7 frame
  lift: q=0 is STEP assembled pose; positive +Z; SolidWorks distances 6-325 mm and 7-295 mm normalized to travel 0-0.319 m and 0-0.288 m
  inertials omitted; collision geometry mirrors each STEP visual mesh, origin and scale; RViz is a kinematic preview without a contact solver or collision stop
  gripper pivots: STEP centers are (-27.823872, 28.737296) / (27.823872, -28.737296) mm and (-18.600, 62.500) / (18.600, -62.500) mm; all axes are parallel to +Z
  gripper alignment: crank radius 40.000 mm, link center distance 35.000 mm; proximal axis offset 0.00033 mm and distal link/slider axes coincide within 0.001 mm
  gripper symmetry: link meshes are 180-degree mirrored about the rotor center; jaw envelopes mirror across Y=0 within 0.001 mm
  wrist: J5/J6/J7 origins and axes match the official OpenArm v1.0 description; STEP L6/L7 combine multiple moving wrist members and cannot serve as one rigid URDF link; the two STEP J7_D connecting members are extracted separately into link7, while the full official link7 visual remains omitted because it overlaps the retained STEP gripper motor
  gripper: the fixed link7-to-gripper mount is compensated for the restored official wrist origins so the STEP gripper keeps its zero-pose placement
  gripper kinematics: a ROS node solves the STEP closed-loop linkage; slider q=0 is the STEP pose, q=-0.04 m closes each jaw
  assumptions: official OpenArm v1.0 wrist geometry and kinematics approximate this v1.1 STEP wrist; STEP has component placement and geometry, not SolidWorks mate definitions
  assumptions: lift force/velocity values are slider placeholders, not actuator specifications
-->
  <link name="world" />
  <link name="lift_base_link">
    <visual name="lift_base_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
